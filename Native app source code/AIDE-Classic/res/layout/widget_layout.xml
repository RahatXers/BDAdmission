<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- top row: logo + uni name + refresh -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/widget_logo"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginEnd="8dp"
                android:background="#e6ffffff"
                android:padding="2dp"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/widget_uni_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="ভর্তি কাউন্টডাউন"
                android:textColor="#93c5fd"
                android:textSize="11.5sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <ImageView
                android:id="@+id/widget_refresh"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:padding="4dp"
                android:src="@drawable/ic_refresh"
                android:contentDescription="Refresh" />
        </LinearLayout>

        <!-- unit name -->
        <TextView
            android:id="@+id/widget_unit_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="অ্যাপ খুলে একটা ইউনিট বেছে নাও"
            android:textColor="#ffffff"
            android:textSize="15sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end" />

        <!-- faculty / sub info -->
        <TextView
            android:id="@+id/widget_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text=""
            android:textColor="#dbeafe"
            android:textSize="10sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:visibility="gone" />

        <!-- exam date line -->
        <TextView
            android:id="@+id/widget_exam_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text=""
            android:textColor="#93c5fd"
            android:textSize="11sp"
            android:visibility="gone" />

        <!-- 4 countdown boxes: days / hours / minutes / seconds -->
        <LinearLayout
            android:id="@+id/widget_countdown_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="#22ffffff"
                android:padding="6dp">
                <TextView
                    android:id="@+id/widget_days_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="০"
                    android:textColor="#ffffff"
                    android:textStyle="bold"
                    android:textSize="16sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="দিন"
                    android:textColor="#93c5fd"
                    android:textSize="8sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="#22ffffff"
                android:padding="6dp">
                <TextView
                    android:id="@+id/widget_hours_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="০"
                    android:textColor="#ffffff"
                    android:textStyle="bold"
                    android:textSize="16sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ঘণ্টা"
                    android:textColor="#93c5fd"
                    android:textSize="8sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="#22ffffff"
                android:padding="6dp">
                <TextView
                    android:id="@+id/widget_minutes_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="০"
                    android:textColor="#ffffff"
                    android:textStyle="bold"
                    android:textSize="16sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="মিনিট"
                    android:textColor="#93c5fd"
                    android:textSize="8sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="#22ffffff"
                android:padding="6dp">
                <TextView
                    android:id="@+id/widget_seconds_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="০"
                    android:textColor="#ffffff"
                    android:textStyle="bold"
                    android:textSize="16sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="সেকেন্ড"
                    android:textColor="#93c5fd"
                    android:textSize="8sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- months/days-remaining pill -->
        <TextView
            android:id="@+id/widget_months_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text=""
            android:textColor="#ffffff"
            android:textStyle="bold"
            android:textSize="11sp"
            android:background="#33ffffff"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:visibility="gone" />

        <!-- exam note -->
        <TextView
            android:id="@+id/widget_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text=""
            android:textColor="#dbeafe"
            android:textSize="9.5sp"
            android:maxLines="2"
            android:ellipsize="end"
            android:visibility="gone" />

    </LinearLayout>
</FrameLayout>

